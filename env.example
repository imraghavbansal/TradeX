# Copy this file to .env.local in the same directory and fill in real values.

# === Finnhub (market data, search, news) ===
NEXT_PUBLIC_FINNHUB_API_KEY=
FINNHUB_API_KEY=

# === MongoDB (auth, watchlist, alerts) ===
MONGODB_URI=

# === Better Auth ===
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# === Gemini (Inngest AI steps: welcome email intro, news summarization) ===
GEMINI_API_KEY=

# === Nodemailer (Gmail app password) ===
NODEMAILER_EMAIL=
NODEMAILER_PASSWORD=

# === Site URL (used for absolute links/images in outgoing emails) ===
NEXT_PUBLIC_SITE_URL=http://localhost:3000
